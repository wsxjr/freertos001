# Doxygen configuration for freertos001
# Generate HTML documentation with: doxygen Doxyfile

PROJECT_NAME           = "freertos001 - ICM20602 Attitude System"
PROJECT_BRIEF          = "STM32F407 + FreeRTOS + ICM20602 + SSD1306"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = Chinese
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MARKDOWN_SUPPORT       = YES
TAB_SIZE               = 4
INPUT                  = Core/Inc Core/Src README.md
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
EXCLUDE                = Drivers Middlewares MDK-ARM
EXCLUDE_PATTERNS       = */Drivers/* */Middlewares/* */MDK-ARM/*
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
HAVE_DOT               = NO
QUIET                  = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = docs/doxygen/doxygen_warnings.log
INPUT_ENCODING         = UTF-8

